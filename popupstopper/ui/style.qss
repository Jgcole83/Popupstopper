/* Popup Stopper stylesheet - dark Fluent-ish look, blue accent */

* {
    color: #E6E6E6;
    font-family: "Segoe UI", "Segoe UI Variable", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, QWidget {
    background: #1B1B1B;
}

QTabWidget::pane {
    border: 1px solid #303030;
    background: #1F1F1F;
    top: -1px;
}
QTabBar::tab {
    background: #232323;
    padding: 8px 18px;
    border: 1px solid #303030;
    border-bottom: none;
    color: #C9C9C9;
    min-width: 90px;
}
QTabBar::tab:selected {
    background: #1F1F1F;
    color: #FFFFFF;
    border-bottom: 2px solid #3D8BFF;
}
QTabBar::tab:hover:!selected {
    background: #2C2C2C;
}

QPushButton {
    background: #2A2A2A;
    border: 1px solid #3A3A3A;
    padding: 6px 16px;
    border-radius: 4px;
    color: #E6E6E6;
}
QPushButton:hover {
    background: #333333;
    border-color: #4A4A4A;
}
QPushButton:pressed {
    background: #202020;
}
QPushButton:disabled {
    color: #7A7A7A;
}
QPushButton#PrimaryButton {
    background: #3D8BFF;
    color: white;
    border: none;
    padding: 8px 22px;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover { background: #5A9EFF; }
QPushButton#PrimaryButton:pressed { background: #1B4FB0; }

QPushButton#DangerButton {
    background: #8C2F2F;
    border: 1px solid #A33A3A;
    color: #FFFFFF;
}
QPushButton#DangerButton:hover { background: #A33A3A; }

QGroupBox {
    border: 1px solid #2E2E2E;
    border-radius: 4px;
    margin-top: 14px;
    padding-top: 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #FFFFFF;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background: #191919;
    border: 1px solid #2E2E2E;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #3D8BFF;
    color: #E6E6E6;
}
/* @ASSETS@ is replaced with the assets folder URL when the sheet is loaded. */
QComboBox { min-height: 20px; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow { image: url(@ASSETS@/arrow-down.png); width: 18px; height: 18px; }
QComboBox::down-arrow:hover { image: url(@ASSETS@/arrow-down-hover.png); }
QComboBox QAbstractItemView {
    background: #1F1F1F;
    border: 1px solid #3A3A3A;
    selection-background-color: #3D8BFF;
}

QTableWidget, QTreeWidget, QListWidget {
    background: #191919;
    border: 1px solid #2E2E2E;
    gridline-color: #2A2A2A;
    selection-background-color: #24405F;
    selection-color: #FFFFFF;
    alternate-background-color: #1D1D1D;
}
QHeaderView::section {
    background: #232323;
    color: #C9C9C9;
    border: none;
    border-right: 1px solid #2E2E2E;
    border-bottom: 1px solid #303030;
    padding: 6px 8px;
    font-weight: 600;
}
QTableWidget::item, QTreeWidget::item { padding: 3px 4px; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #4A4A4A;
    background: #1E1E1E;
    border-radius: 3px;
}
QCheckBox::indicator:checked { background: #3D8BFF; border-color: #3D8BFF; }

QRadioButton::indicator {
    width: 15px; height: 15px;
    border: 1px solid #4A4A4A;
    background: #1E1E1E;
    border-radius: 8px;
}
QRadioButton::indicator:checked { background: #3D8BFF; border-color: #3D8BFF; }

QSplitter::handle { background: #2A2A2A; }

QLabel#SubtleLabel  { color: #9A9A9A; }
QLabel#TitleLabel   { font-size: 12pt; font-weight: 600; color: #FFFFFF; }
QLabel#StatusOk     { color: #2ECC71; font-weight: 600; }
QLabel#StatusWarn   { color: #F39C12; font-weight: 600; }
QLabel#StatusCrit   { color: #E74C3C; font-weight: 600; }
QLabel#MonoLabel    { font-family: "Cascadia Mono", Consolas, monospace; color: #B9C6D8; }

QLabel#StatValue    { font-size: 20pt; font-weight: 600; color: #FFFFFF; }
QLabel#StatLabel    { color: #9A9A9A; font-size: 9pt; }

QFrame#Card {
    background: #1F1F1F;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
}

QScrollBar:vertical {
    background: #1B1B1B; width: 10px; margin: 0;
}
QScrollBar::handle:vertical {
    background: #3A3A3A; border-radius: 5px; min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #4A4A4A; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #1B1B1B; height: 10px; margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3A3A3A; border-radius: 5px; min-width: 20px;
}
QScrollBar::handle:horizontal:hover { background: #4A4A4A; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QToolTip {
    background: #2A2A2A;
    color: #E6E6E6;
    border: 1px solid #4A4A4A;
    padding: 4px;
}
